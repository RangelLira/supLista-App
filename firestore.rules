rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Perfis de usuário ──────────────────────────────────────
    // Qualquer usuário autenticado pode ler perfis (para buscar displayName).
    // Só o próprio usuário pode escrever no seu perfil.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ── Códigos de convite (one-time, 24h) ────────────────────
    // Qualquer autenticado pode ler (para validar um código recebido).
    // Só o dono pode criar.
    // Qualquer autenticado pode atualizar (para marcar used:true) e deletar
    // (para limpar códigos expirados via lookupInviteCode).
    match /invites/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if request.auth != null;
    }

    // ── Solicitações de conexão ────────────────────────────────
    // Remetente cria. Remetente e destinatário lêem e deletam.
    match /shareRequests/{requestId} {
      allow read, delete: if request.auth != null
                          && (resource.data.fromUid == request.auth.uid
                              || resource.data.toUid   == request.auth.uid);
      allow create: if request.auth != null
                    && request.resource.data.fromUid == request.auth.uid;
    }

    // ── Conexões ativas (pares de usuários) ───────────────────
    // Qualquer participante pode ler e deletar.
    // O destinatário cria (via acceptShareRequest).
    // Participante pode atualizar apenas o próprio nome de exibição
    // (fromUid/toUid/createdAt são imutáveis).
    match /shares/{shareId} {
      allow read, delete: if request.auth != null
                          && (resource.data.fromUid == request.auth.uid
                              || resource.data.toUid   == request.auth.uid);
      allow create: if request.auth != null
                    && (request.resource.data.fromUid == request.auth.uid
                        || request.resource.data.toUid == request.auth.uid);
      allow update: if request.auth != null
                    && (resource.data.fromUid == request.auth.uid
                        || resource.data.toUid == request.auth.uid)
                    && request.resource.data.fromUid == resource.data.fromUid
                    && request.resource.data.toUid == resource.data.toUid
                    && request.resource.data.createdAt == resource.data.createdAt;
    }

    // ── Listas compartilhadas ──────────────────────────────────
    // Dono e receptor lêem. Dono cria e deleta. Ambos atualizam (edição
    // colaborativa). O receptor faz update com sharedWithUid:null para "sair".
    match /sharedLists/{docId} {
      allow read: if request.auth != null
                  && (resource.data.ownerUid      == request.auth.uid
                      || resource.data.sharedWithUid == request.auth.uid);
      allow create: if request.auth != null
                    && request.resource.data.ownerUid == request.auth.uid;
      allow update: if request.auth != null
                    && (resource.data.ownerUid      == request.auth.uid
                        || resource.data.sharedWithUid == request.auth.uid);
      allow delete: if request.auth != null
                    && resource.data.ownerUid == request.auth.uid;
    }

  }
}
