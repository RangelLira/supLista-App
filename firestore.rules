rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Perfis de usuário ──────────────────────────────────────
    // Qualquer usuário autenticado pode ler o perfil de um uid que já conhece
    // (para buscar displayName). "get" (doc conhecido) é permitido; "list"
    // (varrer a coleção inteira) é bloqueado — senão qualquer autenticado
    // conseguiria enumerar uid+displayName de todo mundo numa query sem filtro.
    // Só o próprio usuário pode escrever no seu perfil.
    match /users/{userId} {
      allow get: if request.auth != null;
      allow list: if false;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ── Códigos de convite (one-time, 24h) ────────────────────
    // Qualquer autenticado pode ler um código específico que já recebeu (get),
    // pra validar. "list" é bloqueado: o código funciona como uma senha de
    // uso único — sem isso, qualquer autenticado poderia listar a coleção
    // inteira e "roubar" convites pendentes de outras pessoas antes delas.
    // Só o dono pode criar.
    // update: só marcar used:true (nada mais muda) — feito por quem usa o código.
    // delete: só o dono, ou qualquer um se o código já expirou (limpeza).
    match /invites/{code} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null
                    && request.resource.data.ownerUid == request.auth.uid;
      allow update: if request.auth != null
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used'])
                    && request.resource.data.used == true;
      allow delete: if request.auth != null
                    && (resource.data.ownerUid == request.auth.uid
                        || resource.data.get('expiresAt', 0) < request.time.toMillis());
    }

    // ── Solicitações de conexão ────────────────────────────────
    // Remetente cria. Remetente e destinatário lêem e deletam.
    match /shareRequests/{requestId} {
      allow read, delete: if request.auth != null
                          && (resource.data.fromUid == request.auth.uid
                              || resource.data.toUid   == request.auth.uid);
      allow create: if request.auth != null
                    && request.resource.data.fromUid == request.auth.uid;
    }

    // ── Conexões ativas (pares de usuários) ───────────────────
    // Qualquer participante pode ler e deletar.
    // O destinatário cria (via acceptShareRequest).
    // Participante pode atualizar apenas o próprio nome de exibição
    // (fromUid/toUid/createdAt são imutáveis).
    match /shares/{shareId} {
      allow read, delete: if request.auth != null
                          && (resource.data.fromUid == request.auth.uid
                              || resource.data.toUid   == request.auth.uid);
      allow create: if request.auth != null
                    && (request.resource.data.fromUid == request.auth.uid
                        || request.resource.data.toUid == request.auth.uid);
      allow update: if request.auth != null
                    && (resource.data.fromUid == request.auth.uid
                        || resource.data.toUid == request.auth.uid)
                    && request.resource.data.fromUid == resource.data.fromUid
                    && request.resource.data.toUid == resource.data.toUid
                    && request.resource.data.createdAt == resource.data.createdAt;
    }

    // ── Listas compartilhadas ──────────────────────────────────
    // Dono e receptor lêem. Dono cria e deleta. Ambos atualizam (edição
    // colaborativa). O receptor faz update com sharedWithUid:null para "sair".
    // No update: ownerUid é imutável (o receptor não pode "roubar"/quebrar o
    // acesso do dono) e o receptor só pode manter o vínculo ou sair (null),
    // nunca reatribuir a lista para um terceiro.
    match /sharedLists/{docId} {
      allow read: if request.auth != null
                  && (resource.data.ownerUid      == request.auth.uid
                      || resource.data.sharedWithUid == request.auth.uid);
      allow create: if request.auth != null
                    && request.resource.data.ownerUid == request.auth.uid;
      allow update: if request.auth != null
                    && (resource.data.ownerUid      == request.auth.uid
                        || resource.data.sharedWithUid == request.auth.uid)
                    && request.resource.data.ownerUid == resource.data.ownerUid
                    && (resource.data.ownerUid == request.auth.uid
                        || request.resource.data.sharedWithUid == resource.data.sharedWithUid
                        || request.resource.data.sharedWithUid == null);
      allow delete: if request.auth != null
                    && resource.data.ownerUid == request.auth.uid;
    }

  }
}
